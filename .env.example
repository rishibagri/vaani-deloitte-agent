GEMINI_API_KEY=AIza_YOUR_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-live-001
AGENT_NAME=Vaani
AGENT_ROLE=Your AI Assistant
AGENT_VOICE=Puck
BACKEND_PORT=8000
FRONTEND_PORT=5173

# MuseTalk lip sync — "auto" detects CUDA at startup (recommended)
# "true" forces on (requires CUDA + model weights), "false" disables
MUSETALK_ENABLED=auto
MUSETALK_BATCH_MS=200
MUSETALK_VERSION=v15
# Frames per GPU forward pass (higher=faster, lower if out-of-memory)
MUSETALK_GPU_BATCH=16
# float16 inference — ~2x faster; set false if you see artifacts
MUSETALK_FP16=true
# Mouth alignment (fractions of face box): nudge if the mouth is offset/scaled
MOUTH_SCALE=0.95
MOUTH_DX=-0.02
MOUTH_DY=-0.03

CORS_ORIGINS=http://localhost:5173

# PostgreSQL face-recognition memory (set to enable, leave blank to disable)
DATABASE_URL=

# Supabase semantic memory — leave both blank to use local data/memory.json instead
# Create the schema by running the SQL block at the top of backend/memory.py
# in your Supabase project's SQL editor
SUPABASE_URL=
SUPABASE_KEY=
