# ============================================================
#  Vaani environment configuration
#  Copy this file to .env and fill in your values.
#  Every variable below is read by backend/config.py (or, where
#  noted, by backend/main.py / frontend). Defaults shown match
#  the code; uncomment and change only what you need.
# ============================================================

# ---- Gemini (required) -------------------------------------
# API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza_YOUR_KEY_HERE
# Realtime voice model used by the live pipeline (STT + LLM + TTS)
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Text-only model used for memory summaries / non-live calls
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ---- Agent persona -----------------------------------------
AGENT_NAME=Vaani
AGENT_ROLE=Your AI Assistant
# Gemini voice: Puck, Charon, Kore, Fenrir, Aoede
AGENT_VOICE=Puck

# ---- Server ports ------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Admin dashboard (/#admin) -----------------------------
# Password for the admin panel login. CHANGE THIS in production.
ADMIN_PASSWORD=admin2026

# ============================================================
#  MuseTalk lip sync (GPU only — ignored on Mac / CPU)
# ============================================================
# "auto" enables MuseTalk only when a CUDA GPU AND model weights
# are both present. "true" forces on, "false" disables.
MUSETALK_ENABLED=auto
# Model weights version directory under models/ (v15 = MuseTalk V1.5)
MUSETALK_VERSION=v15
# Audio batch size for streaming lip sync (ms)
MUSETALK_BATCH_MS=200
# Frames per GPU forward pass (higher = faster; lower if out-of-memory)
MUSETALK_GPU_BATCH=16
# float16 inference — ~2x faster; set false if you see artifacts/NaNs
MUSETALK_FP16=true

# ---- Neural mouth codebook (viseme cache) ------------------
# Reuse generated mouths for repeated visemes (big speedup, self-warms)
MUSETALK_MOUTH_CACHE=true
# Cosine similarity threshold for a cache hit (code default 0.96)
MUSETALK_CACHE_SIM=0.96
# Max cached visemes
MUSETALK_CACHE_MAX=512

# ---- Mouth fine-tune (landmark alignment usually makes these
#      unnecessary — leave neutral unless the mouth looks off) ----
MOUTH_SCALE=1.0
MOUTH_DX=0.0
MOUTH_DY=0.0
# Mouth-blend vertical band (fractions of the canonical 256 crop).
# Raise/lower to cover more or less of the mouth+jaw if a seam shows.
MOUTH_MASK_TOP=0.50
MOUTH_MASK_FULL=0.62

# ============================================================
#  Persistent memory (both optional)
# ============================================================
# PostgreSQL face-recognition memory. Leave blank to disable.
# For Supabase, use the SESSION POOLER connection string from
#   Project Settings -> Database -> Connection string -> Session pooler
# (the direct db.<ref>.supabase.co host often fails to resolve).
# Example (local):    postgresql://USER@localhost:5432/vaani
# Example (Supabase): postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase semantic memory. Leave both blank to fall back to
# a local data/memory.json file. Create the schema by running the
# SQL block at the top of backend/memory.py in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_KEY=

# ============================================================
#  Frontend (set in frontend/.env.local, NOT here) — for reference:
#  VITE_BACKEND_URL  Backend URL the frontend proxies to.
#                    Leave unset for localhost:8000. Set to your
#                    ngrok URL when using a remote/Kaggle GPU backend.
# ============================================================
